# ============================================================
# F1 2026 Predictive Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── FastF1 Cache ────────────────────────────────────────────
# FastF1 caches ~500MB per season of telemetry data.
# Stored inside .cache to keep project self-contained while remaining ignored by Git.
F1_FASTF1_CACHE_DIR=.cache/fastf1

# ── Data Layer Paths (relative to project root) ─────────────
F1_DATA_RAW_DIR=data/raw
F1_DATA_PROCESSED_DIR=data/processed
F1_DATA_OUTPUTS_DIR=data/outputs
F1_DATA_EXTERNAL_DIR=data/external
F1_MODELS_DIR=models/artifacts
F1_REPORTS_DIR=reports

# ── Pipeline Parameters ─────────────────────────────────────
F1_TARGET_SEASON=2026
F1_RANDOM_SEED=42
F1_CV_N_SPLITS=5
F1_LOG_LEVEL=INFO

# ── AI (Gemini) ─────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# Gemini 3.1 Pro is the primary reasoning model for race narratives.
# Gemini 3.5 Flash is the fallback to keep automated reports publishing
# when Pro preview quota, billing, or availability blocks a run.
F1_GEMINI_API_KEY=your_gemini_api_key_here
F1_GEMINI_MODEL=gemini-3.1-pro-preview
F1_GEMINI_FALLBACK_MODEL=gemini-3.5-flash
F1_GEMINI_RETRIES=2

# ── External Weather Intelligence (optional) ─────────────────
# Used by Friday pre-race forecasts to enrich rain probability,
# temperature, humidity, and wind context before FastF1 weather exists.
# Supported providers: visualcrossing, openweather
F1_WEATHER_PROVIDER=visualcrossing
F1_VISUAL_CROSSING_API_KEY=your_visual_crossing_api_key_here
F1_OPENWEATHER_API_KEY=your_openweather_api_key_here
F1_WEATHER_TIMEOUT_SECONDS=8
F1_WEATHER_FORECAST_DAYS=7

# ── Notification System (Gmail SMTP) ────────────────────────
# All fields are OPTIONAL. If not set, pipeline runs normally
# but skips sending email/Discord notifications.
#
# Step 1: Enable 2-Step Verification on your Google account.
# Step 2: Go to myaccount.google.com/apppasswords
# Step 3: Create an App Password named "F1 Briefings"
# Step 4: Paste the 16-char code (without spaces) below.
#
F1_GMAIL_USER=yourgmail@gmail.com
F1_GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
F1_RECIPIENT_EMAIL=recipient@example.com

# ── Notification System (Discord — optional) ─────────────────
# Create a webhook at: Server Settings → Integrations → Webhooks
# This is a secret — never commit the real URL.
F1_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ── Cloud Cache (Supabase S3 — optional) ─────────────────────
# Persists the FastF1 cache (~200MB) across serverless runs on Trigger.dev.
# Without this, every cold-start re-downloads telemetry from the FastF1 CDN
# (~2-5 min overhead). Set all 4 vars to enable; leave blank for local dev.
#
# Setup:
#   1. Create a free Supabase project at supabase.com
#   2. Create a Storage bucket named "f1-cache" (private)
#   3. Dashboard → Storage → S3 Access Keys → Create new key
#   4. Project ref found at: Project Settings → General → Reference ID
#
SUPABASE_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=your_supabase_s3_access_key_here
SUPABASE_S3_SECRET_KEY=your_supabase_s3_secret_key_here
SUPABASE_S3_BUCKET_NAME=f1-cache

# ── Trigger.dev (optional — required for cloud worker auto-deploy) ────────────
# Personal Access Token from: app.trigger.dev → Account Settings → Access Tokens
# Add this as a GitHub Secret named TRIGGER_ACCESS_TOKEN for the CI deploy job.
# Not needed locally — only used by the GitHub Actions deploy-trigger job.
TRIGGER_ACCESS_TOKEN=your_trigger_dev_token_here

# ── Databricks Lakehouse (optional — required for cloud Databricks integration) ─
# Workspace URL:   Databricks workspace → top-right user menu → "Copy link"
# PAT (dev):       User Settings → Developer → Access Tokens → Generate new token
# SP credentials:  Used in production CI/CD only (NEVER use PAT in prod pipelines)
#
# Setup guide: https://docs.databricks.com/dev-tools/cli/authentication.html
#
# For local dev: run `databricks configure --host <DATABRICKS_HOST>` instead
# of setting DATABRICKS_TOKEN — this stores credentials in ~/.databrickscfg
#
DATABRICKS_HOST=https://<workspace-id>.azuredatabricks.net

# Personal Access Token — dev/staging only (never commit the real value)
DATABRICKS_TOKEN=dapi_your_databricks_pat_here

# Cluster ID for Databricks Connect v2 (integration tests only)
# Find it: Compute → your cluster → Configuration tab → "JDBC/ODBC" → Cluster ID
DATABRICKS_CLUSTER_ID=your_cluster_id_here

# Service Principal — production CI/CD (GitHub Actions) only
# Create at: Databricks workspace → Settings → Identity & Access → Service Principals
DATABRICKS_CLIENT_ID=your_service_principal_client_id
DATABRICKS_CLIENT_SECRET=your_service_principal_client_secret
DATABRICKS_SP_NAME=f1-2026-predictions-sp

# MLflow tracking URI (auto-detected on Databricks; set for local experiments)
# Leave blank when running on Databricks — tracking is configured automatically.
# For local use: set to "http://localhost:5000" after running `mlflow ui`
MLFLOW_TRACKING_URI=
